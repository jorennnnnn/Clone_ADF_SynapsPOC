{
	"name": "pl_silver_to_gold",
	"properties": {
		"description": "Metadata-driven Copy Activity pipeline that promotes one table from Silver to Gold.\n\nFor each table it:\n  1. Logs a RUNNING execution row in ctrl.PipelineExecution.\n  2. Runs a Copy Activity whose SOURCE is a Serverless SQL query that\n     reads from the Silver zone via OPENROWSET, optionally running a\n     custom GoldQuery (aggregations / dimensional model) stored in\n     ctrl.SourceTable.GoldQuery. When no custom query is provided,\n     a pass-through SELECT is used, allowing the Gold dataset to be\n     a clean, BI-optimised snapshot of Silver.\n  3. Writes Parquet to the Gold zone.\n  4. Updates the execution log with SUCCESS or FAILED status.",
		"activities": [
			{
				"name": "act_set_run_id",
				"description": "Generate a unique run identifier.",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"typeProperties": {
					"variableName": "RunId",
					"value": {
						"value": "@guid()",
						"type": "Expression"
					}
				}
			},
			{
				"name": "act_set_load_date",
				"description": "Set today's date as the partition key.",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"typeProperties": {
					"variableName": "LoadDate",
					"value": {
						"value": "@formatDateTime(utcNow(), 'yyyy-MM-dd')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "act_get_gold_query",
				"description": "Fetch optional custom GoldQuery from ctrl.SourceTable.",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "act_set_load_date",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:02:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT ISNULL(GoldQuery, '''') AS GoldQuery FROM ctrl.SourceTable WHERE SourceTableId = ', string(pipeline().parameters.SourceTableId))",
							"type": "Expression"
						},
						"queryTimeout": "00:02:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_azuresql_control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "act_log_start",
				"description": "Insert a RUNNING execution record into ctrl.PipelineExecution.",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "act_set_run_id",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "act_get_gold_query",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:02:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('EXEC ctrl.usp_log_execution_start @PipelineName = ''pl_silver_to_gold'', @RunId = ''', variables('RunId'), ''', @SourceTableId = ', string(pipeline().parameters.SourceTableId), ', @SourceConnectionName = ''', pipeline().parameters.SourceConnectionName, ''', @TableName = ''', pipeline().parameters.TableName, ''', @Layer = ''GOLD'', @LoadDate = ''', variables('LoadDate'), '''')",
							"type": "Expression"
						},
						"queryTimeout": "00:02:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_azuresql_control",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "act_copy_silver_to_gold",
				"description": "Copy Activity: reads from Silver zone via Serverless SQL OPENROWSET and writes Parquet to Gold zone. Uses a custom GoldQuery from metadata when available, otherwise performs a full pass-through.",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "act_log_start",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "1.00:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 60,
					"secureOutput": false,
					"secureInput": false
				},
				"typeProperties": {
					"source": {
						"type": "SqlDWSource",
						"sqlReaderQuery": {
							"value": "@if(\n  not(empty(activity('act_get_gold_query').output.firstRow.GoldQuery)),\n  activity('act_get_gold_query').output.firstRow.GoldQuery,\n  concat(\n    'SELECT * FROM OPENROWSET(',\n    'BULK ''/', pipeline().parameters.SourceConnectionName, '/', pipeline().parameters.TableName, '/*/*.parquet'',',\n    ' DATA_SOURCE = ''silver'', FORMAT = ''PARQUET'') src'\n  )\n)",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "ds_serverless_sql_source",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_adls_parquet_gold",
						"type": "DatasetReference",
						"parameters": {
							"folderPath": {
								"value": "@concat(pipeline().parameters.SourceConnectionName, '/', pipeline().parameters.TableName, '/loaddate=', variables('LoadDate'))",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "act_log_success",
				"description": "Mark the execution log row as SUCCESS.",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "act_copy_silver_to_gold",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.00:02:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"linkedServiceName": {
					"referenceName": "ls_azuresql_metadata",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "NonQuery",
							"text": {
								"value": "@concat('EXEC ctrl.usp_log_execution_end @RunId = ''', variables('RunId'), ''', @Layer = ''GOLD'', @Status = ''SUCCESS'', @RowsWritten = ', string(activity('act_copy_silver_to_gold').output.rowsCopied))",
								"type": "Expression"
							}
						}
					],
					"logSettings": {
						"enableReliableLogging": false
					}
				}
			},
			{
				"name": "act_log_failure",
				"description": "On any upstream failure, mark the execution log row as FAILED.",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "act_copy_silver_to_gold",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.00:02:00",
					"retry": 1,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"linkedServiceName": {
					"referenceName": "ls_azuresql_metadata",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "NonQuery",
							"text": {
								"value": "@concat('EXEC ctrl.usp_log_execution_end @RunId = ''', variables('RunId'), ''', @Layer = ''GOLD'', @Status = ''FAILED'', @ErrorMessage = ''', replace(string(activity('act_copy_silver_to_gold').error), '''', ''''''), '''')",
								"type": "Expression"
							}
						}
					],
					"logSettings": {
						"enableReliableLogging": false
					}
				}
			}
		],
		"parameters": {
			"SourceTableId": {
				"type": "int",
				"defaultValue": 0
			},
			"SourceConnectionName": {
				"type": "string",
				"defaultValue": ""
			},
			"TableName": {
				"type": "string",
				"defaultValue": ""
			}
		},
		"variables": {
			"RunId": {
				"type": "String"
			},
			"LoadDate": {
				"type": "String"
			}
		},
		"folder": {
			"name": "medallion"
		},
		"annotations": []
	}
}
